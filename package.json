{
  "name": "@dreamonkey/graphql-codegen-stack-monorepo",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "private": true,
  "scripts": {
    "build": "pnpm run --recursive --stream --parallel build",
    "test": "vitest run --config e2e/vitest.config.mts",
    "lint": "eslint . --ext .ts,.js,.cjs",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,mts,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,mts,json,yaml,yml,md}\"",
    "deploy": "pnpm run build && pnpm -r publish"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.5.1",
    "eslint": "^8.52.0",
    "eslint-config-coralloy": "^0.2.1",
    "execa": "^10.2.1",
    "prettier": "^3.0.3",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
